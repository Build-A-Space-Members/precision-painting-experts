{
  "name": "precision-painting-experts",
  "version": "1.0.0",
  "description": "Precision Paint Experts — SEO-first Node.js website (North Central Florida painting contractor)",
  "main": "server.js",
  "scripts": {
    "build": "node src/build.js",
    "build:staging": "SITE_ENV=staging node src/build.js",
    "start": "node server.js",
    "dev": "node src/build.js && node server.js",
    "images": "node scripts/images.js",
    "check:seo": "node scripts/seo-check.js",
    "check:similarity": "node scripts/similarity.js",
    "test:webmcp": "node scripts/webmcp-test.mjs",
    "test": "npm run build && npm run check:seo && npm run check:similarity"
  },
  "keywords": [
    "painting",
    "contractors",
    "home-services"
  ],
  "author": "Precision Painting Experts",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=18"
  }
}
